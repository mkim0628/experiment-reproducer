{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://experiment-reproducer/schemas/plan.schema.json",
  "title": "Implementation plan sidecar (implementation-planner output, accompanies plan.md)",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "strategy", "stack", "modules", "test_plan", "reproduction_targets", "open_decisions", "build_order"],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "justification"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["fork_official", "wrap_third_party", "from_scratch"]
        },
        "source_url": {"type": ["string", "null"]},
        "justification": {"type": "string", "minLength": 1}
      }
    },
    "stack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "framework", "key_libs"],
      "properties": {
        "language": {"type": "string", "minLength": 1},
        "framework": {"type": "string", "minLength": 1},
        "key_libs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "purpose", "implements", "public_api"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "implements": {
            "type": "array",
            "minItems": 1,
            "description": "Names of method_spec components this module implements.",
            "items": {"type": "string", "minLength": 1}
          },
          "public_api": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "test_plan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component", "test_name", "what_it_pins_down"],
        "properties": {
          "component": {"type": "string", "minLength": 1},
          "test_name": {"type": "string", "minLength": 1},
          "what_it_pins_down": {"type": "string", "minLength": 1}
        }
      }
    },
    "reproduction_targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric", "dataset", "paper_value"],
        "properties": {
          "metric": {"type": "string", "minLength": 1},
          "dataset": {"type": "string", "minLength": 1},
          "paper_value": {"type": ["string", "number"]},
          "tolerance": {"type": ["string", "number", "null"]}
        }
      }
    },
    "open_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "options"],
        "properties": {
          "question": {"type": "string", "minLength": 1},
          "options": {
            "type": "array",
            "minItems": 2,
            "items": {"type": "string", "minLength": 1}
          },
          "recommended": {"type": ["string", "null"]}
        }
      }
    },
    "build_order": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
