{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://experiment-reproducer/schemas/analysis.schema.json",
  "title": "Paper analysis (paper-analyzer output)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "problem",
    "prior_limitations",
    "contributions",
    "method_summary",
    "datasets",
    "hyperparameters",
    "metrics",
    "baselines",
    "compute_requirements",
    "open_questions"
  ],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "problem": {"type": "string", "minLength": 1},
    "prior_limitations": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "contributions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "method_summary": {"type": "string", "minLength": 1},
    "datasets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["name"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "split": {"type": "string"},
          "size": {"type": "string"},
          "source": {"type": "string"},
          "version_or_revision": {"type": "string"}
        }
      }
    },
    "hyperparameters": {
      "type": "object",
      "additionalProperties": {"type": ["string", "number", "boolean", "null"]}
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "definition_or_section"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "definition_or_section": {"type": "string", "minLength": 1}
        }
      }
    },
    "baselines": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "reported_score", "metric"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "reported_score": {"type": ["string", "number"]},
          "metric": {"type": "string", "minLength": 1}
        }
      }
    },
    "compute_requirements": {"type": "string"},
    "open_questions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  }
}
