{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://experiment-reproducer/schemas/validation_report.schema.json",
  "title": "Validation report sidecar (experiment-validator output, accompanies report.md)",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "verdict", "environment", "runs", "results", "discrepancies", "next_actions"],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "verdict": {
      "type": "string",
      "enum": ["REPRODUCED", "PARTIALLY_REPRODUCED", "NOT_REPRODUCED"]
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hardware", "software", "seeds", "dataset_versions"],
      "properties": {
        "hardware": {"type": "string", "minLength": 1},
        "software": {"type": "string", "minLength": 1},
        "seeds": {
          "type": "array",
          "items": {"type": "integer"}
        },
        "dataset_versions": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        }
      }
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["run_id", "config", "seed", "status"],
        "properties": {
          "run_id": {"type": "string", "minLength": 1},
          "config": {"type": "string"},
          "seed": {"type": ["integer", "null"]},
          "wall_time": {"type": ["string", "null"]},
          "status": {
            "type": "string",
            "enum": ["OK", "FAILED", "SKIPPED"]
          },
          "skip_reason": {"type": ["string", "null"]}
        }
      }
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric", "dataset", "paper_value", "our_value", "within_tolerance"],
        "properties": {
          "metric": {"type": "string", "minLength": 1},
          "dataset": {"type": "string", "minLength": 1},
          "paper_value": {"type": ["string", "number"]},
          "our_value": {"type": ["string", "number", "null"]},
          "delta": {"type": ["string", "number", "null"]},
          "within_tolerance": {"type": "boolean"}
        }
      }
    },
    "discrepancies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric", "checklist", "hypothesis"],
        "properties": {
          "metric": {"type": "string", "minLength": 1},
          "checklist": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "enum": ["ok", "mismatch", "unknown"]
            }
          },
          "hypothesis": {"type": "string", "minLength": 1}
        }
      }
    },
    "next_actions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  }
}
