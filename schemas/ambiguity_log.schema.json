{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://experiment-reproducer/schemas/ambiguity_log.schema.json",
  "title": "Ambiguity log sidecar (ambiguity-resolver output, accompanies ambiguity_log.md)",
  "type": "object",
  "additionalProperties": false,
  "required": ["resolutions", "escalated_to_user"],
  "properties": {
    "resolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["original_unknown", "resolution", "source", "confidence"],
        "properties": {
          "original_unknown": {"type": "string", "minLength": 1},
          "resolution": {"type": "string", "minLength": 1},
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "citation"],
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["paper", "official_code", "third_party_code", "related_paper", "user"]
              },
              "citation": {"type": "string", "minLength": 1}
            }
          },
          "confidence": {
            "type": "string",
            "enum": ["HIGH", "MEDIUM", "LOW"]
          }
        }
      }
    },
    "escalated_to_user": {
      "type": "array",
      "description": "Unknowns that remain unresolved and require user input.",
      "items": {"type": "string", "minLength": 1}
    }
  }
}
